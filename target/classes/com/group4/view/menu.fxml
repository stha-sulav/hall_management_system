<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>

<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="TOP_CENTER" spacing="10.0" styleClass="menu-pane" xmlns="http://javafx.com/javafx/17.0.10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group4.controller.MenuController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <MFXButton fx:id="dashboardButton" onAction="#handleDashboard" prefWidth="150.0" text="Dashboard" styleClass="menu-button">
          </MFXButton>
      <MFXButton fx:id="studentsButton" onAction="#handleStudents" prefWidth="150.0" text="Students" styleClass="menu-button">
           </MFXButton>
      <MFXButton fx:id="roomsButton" onAction="#handleRooms" prefWidth="150.0" text="Rooms" styleClass="menu-button">
           </MFXButton>
      <MFXButton fx:id="settingsButton" onAction="#handleSettings" prefWidth="150.0" text="Settings" styleClass="menu-button">
           </MFXButton>

      <VBox VBox.vgrow="ALWAYS" />

      <MFXButton onAction="#toggleTheme" prefWidth="150.0" text="Toggle Theme" styleClass="theme-toggle-button">
          </MFXButton>

      <MFXButton fx:id="logoutButton" onAction="#handleLogout" prefWidth="150.0" text="Logout" styleClass="menu-button-logout">
           </MFXButton>

   </children>
</VBox>
